<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ tiene su propia pantalla de splash del sistema (se ve
         ANTES de que cargue Flutter) — sin esto, usa un fondo blanco por
         defecto detrás del ícono en vez del negro de la marca. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#050406</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#050406</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
