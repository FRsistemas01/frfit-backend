# Copiar a .env y completar. En local, con solo GEMINI_API_KEY alcanza.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Límites del plan free (opcionales — si no están, usan estos valores por defecto)
COACH_CHAT_FREE_DAILY_LIMIT=5
SCAN_PHOTO_FREE_DAILY_LIMIT=3
RECIPES_FREE_LIMIT=5

# --- Solo hace falta tocar esto al desplegar a un servidor real ---

# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=nutria-backend.onrender.com

# En Render, si conectás una base Postgres al servicio, esta la completa sola.
# No hace falta setearla a mano.
DATABASE_URL=
